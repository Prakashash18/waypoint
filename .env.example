# Waypoint Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (for GPT-4 reasoning and conversation)
# Required for full functionality - get your key at https://platform.openai.com
OPENAI_API_KEY=

# AviationStack API Key (for real flight delay data)
# Free tier: 100 requests/month — sign up at https://aviationstack.com
# Without this key, delay data is simulated/fake
AVIATIONSTACK_API_KEY=

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Server configuration
HOST=0.0.0.0
PORT=5000
